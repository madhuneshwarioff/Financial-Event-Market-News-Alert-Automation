# Copy to .env and fill in. .env is git-ignored.

# --- Data sources -----------------------------------------------------------
# Free tier: https://finnhub.io/register  (calendars + company news)
FINNHUB_API_KEY=
# Optional second news feed: https://newsapi.org/register
NEWSAPI_KEY=

# --- Telegram ---------------------------------------------------------------
# 1. Message @BotFather, run /newbot, copy the token below.
# 2. Send your bot a message, open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (SMTP) -----------------------------------------------------------
# Gmail requires a 16-character app password, not your account password.
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SENDER=
EMAIL_RECIPIENTS=you@example.com,someone.else@example.com
